---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h2>Sketches</h2>
			<p>
				Foodtown - this is a sketch I wrote for my Maude team Peach in 2020. It was performed at the UBCTNY Hell’s Kitchen theater.
			</p>
			<iframe class="pagelayer-video-iframe" width="100%" height="400" src="https://www.youtube.com/embed/sq3-b477aIM?autoplay=0&mute=0&loop=0&playlist=sq3-b477aIM" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
			<p>
				Alone - Bushcraft GameCube - a little video I made in Prospect Park.
			</p>
			<iframe class="pagelayer-video-iframe" width="100%" height="400" src="https://www.youtube.com/embed/QM42_K4utxE?autoplay=0&mute=0&loop=0&playlist=QM42_K4utxE" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
			<p>
				Crocs - for Ponyboy.
			</p>
			<iframe class="pagelayer-video-iframe" width="100%" height="400" src="https://www.youtube.com/embed/hoYGL10ln9w?autoplay=0&mute=0&loop=0&playlist=hoYGL10ln9w" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
			<p>
				Big Chair - For Ponyboy.
			</p>
			<iframe class="pagelayer-video-iframe" width="100%" height="400" src="https://www.youtube.com/embed/kUkp6UXipxQ?autoplay=0&mute=0&loop=0&playlist=kUkp6UXipxQ" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
			<p>
				Paint and Pinot - this is the first sketch I wrote for Peach. It was supposed to be featured on an industry showcase show put together by the UCB on March 12, 2020 (the night the theater shut down - Sad!)
			</p>
			<iframe class="pagelayer-video-iframe" width="100%" height="400" src="https://www.youtube.com/embed/REvZeGL6M-U?autoplay=0&mute=0&loop=0&playlist=REvZeGL6M-U" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
			<p>
				Song and Dance Man - for Ponyboy.
			</p>
			<iframe class="pagelayer-video-iframe" width="100%" height="400" src="https://www.youtube.com/embed/phMU7ViAL5g?autoplay=0&mute=0&loop=0&playlist=phMU7ViAL5g" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
			<p>
				Someone Has Tipped Over My Hog - for Ponyboy.
			</p>
			<iframe class="pagelayer-video-iframe" width="100%" height="400" src="https://www.youtube.com/embed/FiKxZD02lkc?autoplay=0&mute=0&loop=0&playlist=FiKxZD02lkc" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
